# Changes to this mounted file reload automatically; no rebuild or restart.
# Optional scheduling timezone override: CRON_TZ=Asia/Dubai
# Capture and commit all changed files in the configured repository every 30 min.
*/30 * * * * /app/commit.sh >>/proc/1/fd/1 2>>/proc/1/fd/2
# Publish committed files every 5 min; conflicted files remain queued for retry.
*/5 * * * * /app/push.sh >>/proc/1/fd/1 2>>/proc/1/fd/2
